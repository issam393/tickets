# Frontend environment template for Vite.
# Copy this file to `.env` when setting up the frontend locally:
#   cp frontend_ticket_gestion/.env.example frontend_ticket_gestion/.env
#
# IMPORTANT:
# Every variable exposed to a Vite frontend must start with `VITE_`.
# These values are bundled into the browser, so they are PUBLIC.
# Never put private secrets here:
# - no database password
# - no JWT_SECRET
# - no Gmail app password
# - no admin password

# API base URL used by frontend `fetch(...)` calls.
# Where it comes from:
# - Backend server is started from `backend_ticket_gestion/src/index.js`.
# - Backend port comes from backend `.env` variable `PORT`.
# - Backend routes are mounted in `backend_ticket_gestion/src/app.js` under `/api`.
# Local development example:
# - Backend PORT=2300
# - API route prefix=/api
# - Result: http://localhost:2300/api
# Production example:
# - If backend is deployed at https://api.your-domain.com
# - Use: VITE_API_URL=https://api.your-domain.com/api
VITE_API_URL=http://localhost:2300/api

# Socket.IO server URL used by real-time chat/messages.
# Where it comes from:
# - Socket.IO is attached to the same HTTP server in `backend_ticket_gestion/src/index.js`.
# - It uses the backend origin only, WITHOUT `/api`.
# Local development example:
# - Backend PORT=2300
# - Result: http://localhost:2300
# Production example:
# - If backend/socket server is https://api.your-domain.com
# - Use: VITE_SOCKET_URL=https://api.your-domain.com
VITE_SOCKET_URL=http://localhost:2300

# Reminder:
# The backend `.env` must allow this frontend origin through CORS.
# For local Vite dev, backend should usually have:
#   FRONTEND_URL=http://localhost:5173
