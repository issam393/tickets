PORT=2300
JWT_SECRET="replace_with_a_long_random_secret"
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:5173
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_REQUESTS=10
DB_HOST=localhost
DB_NAME=replace_with_database_name
DB_PWD=replace_with_database_password
DB_USER=replace_with_database_user

# Shared Service Delivery Gmail inbox. Never commit the real app password.
GMAIL_IMAP_USER=service_delivery_inbox@example.com
GMAIL_APP_PASSWORD=replace_with_gmail_app_password
GMAIL_SYNC_INTERVAL_MS=60000

# Local-only admin/bootstrap scripts. Never commit real values.
ADMIN_INITIAL_FIRST_NAME="Admin"
ADMIN_INITIAL_LAST_NAME="User"
ADMIN_INITIAL_EMAIL="admin@example.com"
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="replace_with_strong_admin_password"
ENABLE_ADMIN_BOOTSTRAP=false
