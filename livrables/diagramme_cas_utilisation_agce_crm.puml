@startuml
title Diagramme de cas d'utilisation - AGCE CRM

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam actorStyle stickman
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #1F2937
  FontColor #111827
}
skinparam rectangle {
  BorderColor #111827
  FontColor #111827
}
skinparam ArrowColor #374151

actor "Administrateur" as Admin
actor "Service Delivery" as Delivery
actor "Service IT" as IT
actor "Service PKI" as PKI
actor "Manager" as Manager

rectangle "AGCE CRM" {
  package "Accès commun" {
    usecase "S'authentifier" as UC_Auth
    usecase "Vérifier l'état actif du compte" as UC_Active
    usecase "Accéder au tableau de bord" as UC_Dashboard
    usecase "Consulter son profil" as UC_Profile
    usecase "Se déconnecter" as UC_Logout
  }

  package "Administration" {
    usecase "Gérer les employés" as UC_GererEmployes
    usecase "Créer un employé" as UC_CreerEmploye
    usecase "Modifier un employé" as UC_ModifierEmploye
    usecase "Désactiver un compte" as UC_DesactiverCompte
    usecase "Gérer les rôles et les accès" as UC_RolesAcces
  }

  package "Service Delivery" {
    usecase "Gérer les organisations clientes" as UC_Org
    usecase "Gérer les contacts clients" as UC_Contacts
    usecase "Créer un ticket" as UC_CreerTicket
    usecase "Sélectionner une organisation cliente" as UC_SelectOrg
    usecase "Sélectionner un contact client" as UC_SelectContact
    usecase "Consulter les tickets" as UC_ConsulterTickets
    usecase "Affecter un ticket" as UC_Affecter
    usecase "Historiser l'affectation" as UC_Historiser
    usecase "Suivre l'état d'un ticket" as UC_SuivreTicket
    usecase "Ajouter un commentaire" as UC_Commentaire
    usecase "Consulter les e-mails clients" as UC_Emails
    usecase "Planifier un meeting lié à un ticket" as UC_MeetingTicket
  }

  package "Services techniques" {
    usecase "Consulter les tickets IT" as UC_TicketsIT
    usecase "Traiter un ticket IT" as UC_TraiterIT
    usecase "Consulter les tickets PKI" as UC_TicketsPKI
    usecase "Traiter un ticket PKI" as UC_TraiterPKI
    usecase "Résoudre un ticket" as UC_Resoudre
    usecase "Mettre à jour le statut du ticket" as UC_UpdateStatut
  }

  package "Pilotage managérial" {
    usecase "Consulter les tableaux de bord analytiques" as UC_Analytics
    usecase "Suivre les indicateurs de performance" as UC_KPI
    usecase "Consulter l'état des tickets" as UC_EtatTickets
    usecase "Consulter l'activité des services" as UC_Activite
    usecase "Consulter les meetings" as UC_Meetings
  }
}

Admin -- UC_Auth
Delivery -- UC_Auth
IT -- UC_Auth
PKI -- UC_Auth
Manager -- UC_Auth

Admin -- UC_Dashboard
Delivery -- UC_Dashboard
IT -- UC_Dashboard
PKI -- UC_Dashboard
Manager -- UC_Dashboard

Admin -- UC_Profile
Delivery -- UC_Profile
IT -- UC_Profile
PKI -- UC_Profile
Manager -- UC_Profile

Admin -- UC_Logout
Delivery -- UC_Logout
IT -- UC_Logout
PKI -- UC_Logout
Manager -- UC_Logout

Admin -- UC_GererEmployes
Admin -- UC_CreerEmploye
Admin -- UC_ModifierEmploye
Admin -- UC_DesactiverCompte
Admin -- UC_RolesAcces

Delivery -- UC_Org
Delivery -- UC_Contacts
Delivery -- UC_CreerTicket
Delivery -- UC_ConsulterTickets
Delivery -- UC_Affecter
Delivery -- UC_SuivreTicket
Delivery -- UC_Commentaire
Delivery -- UC_Emails
Delivery -- UC_MeetingTicket

IT -- UC_TicketsIT
IT -- UC_TraiterIT
IT -- UC_Commentaire
IT -- UC_Resoudre

PKI -- UC_TicketsPKI
PKI -- UC_TraiterPKI
PKI -- UC_Commentaire
PKI -- UC_Resoudre

Manager -- UC_Analytics
Manager -- UC_KPI
Manager -- UC_EtatTickets
Manager -- UC_Activite
Manager -- UC_Meetings

UC_Auth ..> UC_Active : <<include>>
UC_CreerTicket ..> UC_SelectOrg : <<include>>
UC_CreerTicket ..> UC_SelectContact : <<include>>
UC_Affecter ..> UC_Historiser : <<include>>
UC_Resoudre ..> UC_UpdateStatut : <<include>>

UC_Commentaire ..> UC_TraiterIT : <<extend>>
UC_Commentaire ..> UC_TraiterPKI : <<extend>>
UC_MeetingTicket ..> UC_SuivreTicket : <<extend>>
UC_Emails ..> UC_CreerTicket : <<extend>>
@enduml
